{
  "contract_id": "teller-hosted-bootstrap-v1",
  "owner_system": "The Teller",
  "issuer_system": "The Tower",
  "exchange_version": "tower-teller-exchange.v1",
  "exchange_request": {
    "method": "POST",
    "configured_by": "VITE_TOWER_TELLER_EXCHANGE_URL",
    "body_fields": [
      "handoff_code",
      "client",
      "exchange_version"
    ],
    "handoff_code": {
      "kind": "opaque one-time Tower code",
      "may_arrive_in_url_fragment": true,
      "is_persistence_bearer_token": false
    }
  },
  "required_exchange_response_fields": [
    "exchange_version",
    "access_verified",
    "app_id",
    "role",
    "target_path",
    "receipt_id",
    "expires_at_epoch",
    "navigation_context",
    "tower_session_id",
    "actor_id",
    "business_key",
    "persistence_access_token"
  ],
  "existing_tower_fields_preserved": [
    "exchange_version",
    "access_verified",
    "app_id",
    "role",
    "target_path",
    "receipt_id",
    "expires_at_epoch",
    "navigation_context"
  ],
  "new_tower_fields_required": [
    "tower_session_id",
    "actor_id",
    "business_key",
    "persistence_access_token"
  ],
  "persistence_token": {
    "field_name": "persistence_access_token",
    "format": "tpt1.<base64url-json-payload>.<hmac-sha256-signature>",
    "maximum_lifetime_seconds": 600,
    "browser_storage": false,
    "browser_history": false,
    "browser_url": false,
    "browser_logging": false,
    "live_memory_location": "window.__TELLER_TOWER_SESSION__.persistence_access_token"
  },
  "live_session_mapping": {
    "role": "response.role",
    "session_id": "response.tower_session_id",
    "tower_session_id": "response.tower_session_id",
    "tower_receipt_id": "response.receipt_id",
    "actor.id": "response.actor_id",
    "business.key": "response.business_key",
    "navigation_context": "response.navigation_context",
    "persistence_access_token": "response.persistence_access_token"
  },
  "security": {
    "tower_decides_actor_id": true,
    "tower_decides_actor_role": true,
    "tower_decides_business_key": true,
    "tower_decides_session_id": true,
    "tower_decides_receipt_id": true,
    "browser_receives_signing_secret": false,
    "persistence_token_query_parameter": false,
    "persistence_token_url_fragment": false,
    "persistence_token_local_storage": false,
    "persistence_token_session_storage": false,
    "persistence_token_history_state": false,
    "direct_teller_vault": false
  }
}
