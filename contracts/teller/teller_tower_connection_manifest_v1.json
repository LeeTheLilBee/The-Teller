{
  "contract_id": "teller-tower-connection-ready-v1",
  "teller": {
    "repository": "LeeTheLilBee/The-Teller",
    "branch": "teller-tower-request-handoff-dev",
    "app_id": "teller",
    "entry_path": "/teller",
    "handoff_fragment_key": "tower_handoff",
    "exchange_version": "tower-teller-exchange.v2",
    "exchange_url_env": "VITE_TOWER_TELLER_EXCHANGE_URL",
    "persistence_api_url_env": "VITE_TELLER_PERSISTENCE_API_URL"
  },
  "tower": {
    "repository": "LeeTheLilBee/SimpleeMrkTrade",
    "validated_ref": "88af02c06bbcf0029ff12b6e16a38c68c58bf928",
    "exchange_path": "/tower/teller/exchange",
    "allowed_origin_env": "TOWER_TELLER_ALLOWED_ORIGIN"
  },
  "shared_security": {
    "persistence_token_version": "tpt1",
    "issuer": "tower",
    "audience": "teller-persistence",
    "maximum_lifetime_seconds": 600,
    "shared_signing_secret_env": "TELLER_TOWER_TOKEN_SECRET",
    "minimum_secret_length": 32,
    "browser_signing_secret": false,
    "browser_database_credentials": false,
    "persistence_token_storage": "memory_only"
  },
  "teller_server_environment": [
    "DATABASE_URL",
    "TELLER_TOWER_TOKEN_SECRET",
    "TELLER_TRANSPORT_TOKEN_ISSUER",
    "TELLER_TRANSPORT_TOKEN_AUDIENCE",
    "TELLER_TRANSPORT_MAX_TOKEN_LIFETIME_SECONDS",
    "TELLER_ALLOWED_ORIGINS"
  ],
  "required_exchange_response_fields": [
    "exchange_version",
    "access_verified",
    "app_id",
    "role",
    "target_path",
    "receipt_id",
    "expires_at_epoch",
    "navigation_context",
    "tower_session_id",
    "actor_id",
    "business_key",
    "persistence_access_token"
  ],
  "allowed_roles": [
    "employee",
    "manager",
    "owner"
  ],
  "production_rules": {
    "direct_teller_open": "deny",
    "react_mount_before_verified_exchange": false,
    "fresh_handoff_required_after_reload": true,
    "https_exchange_required": true,
    "https_persistence_api_required": true,
    "persistence_token_query_parameter": false,
    "persistence_token_url_fragment": false,
    "persistence_token_local_storage": false,
    "persistence_token_session_storage": false
  }
}
